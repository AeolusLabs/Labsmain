# Enquiry email delivery (Resend). Set these in Vercel for Production (and Preview if wanted),
# or in .env.local for local testing. Never commit real values.

# Required to send directly. Without it the form prepares an email for the visitor to send instead.
RESEND_API_KEY=

# Optional. Must be an address on a domain verified in Resend.
# Defaults to: AeolusLabs Enquiries <enquiries@aeoluslabsltd.com>
ENQUIRY_FROM_EMAIL=
