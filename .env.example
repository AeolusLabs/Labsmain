# Enquiry email delivery (Resend). Set these in Vercel for Production (and Preview if wanted),
# or in .env.local for local testing. Never commit real values.

# Required to send directly. Without it the form prepares an email for the visitor to send instead.
RESEND_API_KEY=

# Optional. Must be an address on a domain verified in Resend.
# Defaults to: AeolusLabs Enquiries <enquiries@aeoluslabsltd.com>
ENQUIRY_FROM_EMAIL=

# Optional AI brief assistant. Set ONE of the two keys before building/deploying to show the chat option.
# Without a key, the contact page shows the ordinary enquiry form.
ANTHROPIC_API_KEY=

# Optional model override; must be available to your Anthropic account.
BRIEF_ASSISTANT_MODEL=

# Optional: use OpenRouter instead of Anthropic directly. The model must support tool calling.
OPENROUTER_API_KEY=
# Optional OpenRouter model slug. Defaults to anthropic/claude-sonnet-4.5.
OPENROUTER_MODEL=

# Only needed when both keys are set: "anthropic" or "openrouter". Anthropic wins by default.
BRIEF_ASSISTANT_PROVIDER=
