{
  "name": "aeoluslabs-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm tokens:generate && next dev",
    "build": "pnpm tokens:check && next build",
    "start": "next start",
    "typecheck": "pnpm tokens:check && tsc --noEmit",
    "tokens:generate": "node scripts/design-system.mjs",
    "tokens:check": "node scripts/design-system.mjs --check && node scripts/reference-audit.mjs",
    "tokens:audit": "node scripts/reference-audit.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@vercel/analytics": "1.6.1",
    "next": "16.4.5",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.7.3"
  }
}
